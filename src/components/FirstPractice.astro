---
import Arrow from './Arrow.astro';
import {content} from '../lib/funnel-content';
const p=content.practice;
---
<section class="first-practice wrap" id="first-practice" aria-labelledby="first-practice-title">
  <div class="first-practice-intro"><h2 id="first-practice-title">{p.title}</h2><p>{p.intro}</p><p id="practice-focus" class="practice-focus" hidden></p><details><summary>{p.exampleLabel}</summary>{p.example.map(s=><p>{s}</p>)}</details></div>
  <form id="first-practice-form" class="practice-workbook"><h3>{p.notes}</h3>{p.fields.map(f=><><label for={`practice-${f.id}`}>{f.label}<span>{f.hint}</span></label><textarea id={`practice-${f.id}`} name={f.id} rows="2" maxlength="1200" placeholder={f.placeholder}></textarea></>)}<button type="submit" class="button button-primary">{p.cta} <Arrow /></button><p class="button-note">{p.privacy}</p><p id="practice-status" class="practice-status" role="status"></p></form>
</section>
<script>
  import {content,copy} from '../lib/funnel-content';
  import {readState,SESSION_KEY,calculate} from '../lib/quiz-v8';
  const p=content.practice;
  try {
    const state=readState(sessionStorage.getItem(SESSION_KEY));
    if(state.screen==='result') {
      const point=content.results[calculate(state.answers).topic];
      const node=document.getElementById('practice-focus')!;node.hidden=false;
      node.textContent=copy(p.focus,{question:point.prompt});
      const intro=document.getElementById('vsl-context');if(intro)intro.textContent=copy(p.context,{topic:point.name});
    }
  } catch {}
  const form=document.getElementById('first-practice-form') as HTMLFormElement;
  form.addEventListener('submit',event=>{
    event.preventDefault();const data=new FormData(form);const status=document.getElementById('practice-status')!;
    if(!p.fields.some(f=>String(data.get(f.id)||'').trim())){status.textContent=p.error;document.getElementById('practice-event')?.focus();return;}
    const text=[`${content.tokens.BRAND} — ${p.fileTitle}`,p.fileSubtitle,...p.fields.map(f=>`\n${f.label}\n${String(data.get(f.id)||'').trim()||p.leftOpen}`),`\n${p.fileReview}`].join('\n');
    const url=URL.createObjectURL(new Blob([text],{type:'text/plain;charset=utf-8'}));const a=document.createElement('a');a.href=url;a.download=content.tokens.BRAND.replace(/\s+/g,'-')+'-my-first-reflection.txt';a.click();setTimeout(()=>URL.revokeObjectURL(url),1000);status.textContent=p.success;
  });
</script>
