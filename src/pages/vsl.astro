---
import Funnel from '../layouts/Funnel.astro';
import BrandHeader from '../components/BrandHeader.astro';
import BrandFooter from '../components/BrandFooter.astro';
import FirstPractice from '../components/FirstPractice.astro';
import Arrow from '../components/Arrow.astro';
import {funnelConfig,safeWebUrl} from '../lib/funnel-config';
import {content,copy} from '../lib/funnel-content';
import '../styles/funnel-v5.css';
const v=content.vsl;
const videoUrl=safeWebUrl(funnelConfig.videoUrl);
const captionsUrl=safeWebUrl(funnelConfig.captionsUrl);
const checkoutUrl=safeWebUrl(funnelConfig.checkoutUrl);
const canPurchase=funnelConfig.salesOpen&&checkoutUrl;
---
<Funnel title={copy(v.title)} description={v.description}>
  <BrandHeader page="vsl" />
  <main id="main">
    <section class="v5-vsl-opening wrap" aria-labelledby="vsl-title"><h1 id="vsl-title">{v.headline[0]}<br /><span>{v.headline[1]}</span></h1><p id="vsl-context" class="lead">{v.intro}</p><a href="#first-practice" class="hero-secondary">{v.cta} <Arrow /></a><div class="v5-film">{videoUrl&&<div class="video-frame" id="film"><video controls playsinline preload="metadata" poster="/brand/vsl-poster.png" aria-label={v.videoLabel}><source src={videoUrl}/>{captionsUrl&&<track kind="captions" src={captionsUrl} srclang="en" label="English" default/>}{v.videoUnsupported} <a href={videoUrl}>{v.videoOpen}</a>.</video></div>}{!videoUrl&&<p class="film-update">{v.videoPending}</p>}{videoUrl&&<p id="video-error" class="video-error" role="status" hidden>{v.videoError}</p>}{videoUrl&&funnelConfig.transcript&&<details class="transcript"><summary>{v.transcript}</summary><p>{funnelConfig.transcript}</p></details>}</div></section>
    <section class="vsl-lesson-intro wrap" data-motion><h2>{v.sectionTitle[0]}<br />{v.sectionTitle[1]}</h2><div>{v.sectionBody.map((p,i)=><p class={i===0?'lead':undefined}>{p}</p>)}</div></section>
    <FirstPractice />
    <section class="vsl-next"><div class="wrap"><h2>{v.nextTitle[0]}<br />{v.nextTitle[1]}</h2><div><p>{v.nextBody}</p>{canPurchase?<a class="button button-dark" href={checkoutUrl}>{v.join} <Arrow /></a>:<a class="button button-dark" href="/#inside">{v.previewCta} <Arrow /></a>}<p class="button-note">{canPurchase?v.purchaseNote:v.previewNote}</p></div></div></section>
    <section class="faq-section wrap" aria-labelledby="practice-faq-title"><h2 id="practice-faq-title">{v.faqTitle}</h2><div class="faqs">{v.faqs.map(f=><details><summary>{f.q}</summary><p>{f.a}</p></details>)}</div></section>
  </main><BrandFooter />
  <script>
    import '../lib/page-motion';
    const video=document.querySelector('video');const error=document.getElementById('video-error');
    const failed=()=>{if(error)error.hidden=false;};video?.addEventListener('error',failed);video?.querySelector('source')?.addEventListener('error',failed);video?.addEventListener('loadeddata',()=>{if(error)error.hidden=true;});
  </script>
</Funnel>
