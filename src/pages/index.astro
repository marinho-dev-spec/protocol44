---
import Funnel from '../layouts/Funnel.astro';
import BrandHeader from '../components/BrandHeader.astro';
import BrandFooter from '../components/BrandFooter.astro';
import Arrow from '../components/Arrow.astro';
import {content,copy} from '../lib/funnel-content';
import '../styles/funnel-v5.css';
import '../styles/signal-identity.css';
const h=content.home;
---
<Funnel surface="home" title={copy(h.title)} description={h.description}>
  <BrandHeader page="home" />
  <main id="main">
    <div class="home-opening"><section class="product-hero wrap" aria-labelledby="product-title">
      <div class="product-hero-copy"><h1 id="product-title">{h.headline[0]}<br />{h.headline[1]} <span class="promise-outcome">{h.headline[2]}</span></h1><p class="hero-intro">{h.intro}</p><p class="hero-description">{h.body}</p><p class="availability-note">{h.status}</p><a class="button button-primary" href="/quiz">{h.cta} <Arrow /></a><p class="button-note">{h.note}</p><a href="#inside" class="hero-secondary">{h.insideLink}</a></div>
      <figure class="editorial-photo"><img src="/brand/quiet-practice-v5.webp" width="1536" height="1024" alt={h.photoAlt} fetchpriority="high" /><figcaption><img src="/brand/symbol-paper.svg" width="48" height="48" alt="" /><span>{h.photoCaption}</span></figcaption></figure>
    </section></div>
    <section class="recognition-section wrap" data-motion aria-labelledby="recognition-title"><h2 id="recognition-title">{h.recognitionTitle[0]}<br />{h.recognitionTitle[1]}</h2><div>{h.recognitionBody.map((p,i)=><p class={i===0?'lead':undefined}>{p}</p>)}</div></section>
    <section class="product-inside wrap" id="inside" aria-labelledby="inside-title"><div class="section-heading" data-motion><h2 id="inside-title">{h.insideTitle[0]}<br />{h.insideTitle[1]}</h2><div>{h.insideBody.map(p=><p>{p}</p>)}</div></div><div class="product-phases">{h.phases.map((p,i)=><article class="product-phase"><div><span class="phase-order" aria-label={copy(h.phaseLabel,{number:i+1})}>{i+1}</span><h3>{p.name}</h3></div><div><h4>{p.title}</h4><p>{p.body}</p></div><p class="phase-output">{p.output}</p></article>)}</div><p class="availability-note">{h.availability}</p></section>
    <section class="example-section" aria-labelledby="example-title"><div class="wrap example-layout"><div data-motion><h2 id="example-title">{h.exampleTitle[0]}<br />{h.exampleTitle[1]}</h2><p>{h.exampleBody}</p><p class="example-disclosure">{h.exampleDisclosure}</p><a href="/vsl#first-practice" class="button button-dark">{h.exampleCta} <Arrow /></a></div><div id="example-story" class="example-workbook"><div class="example-controls" role="group" aria-label={h.exampleLabel}>{h.exampleSteps.map((s,i)=><button type="button" data-example-step={i} aria-pressed={i===0}>{s.label}</button>)}</div>{h.exampleSteps.map((s,i)=><div data-example-panel={i} hidden={i!==0}><h3>{s.title}</h3><p>{s.body}</p><p class="example-question">{s.prompt}</p></div>)}</div></div></section>
    <section class="fit-section wrap" data-motion><h2>{h.fitTitle[0]}<br />{h.fitTitle[1]}</h2><div><p class="lead">{h.fitIntro}</p><ul class="plain-list">{h.fitItems.map(p=><li>{p}</li>)}</ul></div></section>
    <section class="faq-section wrap" aria-labelledby="faq-title"><h2 id="faq-title">{h.faqTitle[0]}<br />{h.faqTitle[1]}</h2><div class="faqs">{h.faqs.map(f=><details><summary>{f.q}</summary><p>{f.a}</p></details>)}</div></section>
    <section class="product-close wrap" data-motion><h2>{h.closeTitle[0]}<br />{h.closeTitle[1]}</h2><p>{h.closeBody}</p><a class="button button-primary" href="/quiz">{h.cta} <Arrow /></a></section>
  </main><BrandFooter /><script>import '../lib/page-motion';</script>
</Funnel>
