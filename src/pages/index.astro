---
import Funnel from '../layouts/Funnel.astro';
import BrandHeader from '../components/BrandHeader.astro';
import BrandFooter from '../components/BrandFooter.astro';
import Arrow from '../components/Arrow.astro';
import {content,copy} from '../lib/funnel-content';
import '../styles/funnel-v5.css';
import '../styles/signal-identity.css';
import '../styles/editorial.css';
const h=content.home;
const e=content.editorial;
---
<Funnel surface="home" title={copy(h.title)} description={h.description}>
  <BrandHeader page="home" />
  <main id="main">
    <div class="home-opening">
      <section class="product-hero" aria-labelledby="product-title">
        <img class="hero-life-image" src="/brand/next-step-canada.webp" srcset="/brand/next-step-canada-768.webp 768w, /brand/next-step-canada.webp 1536w" sizes="100vw" width="1536" height="1024" fetchpriority="high" alt={e.photoAlt} />
        <div class="product-hero-copy" data-motion="text">
          <p class="section-kicker">{e.heroKicker}</p>
          <h1 id="product-title"><span class="headline-start">{h.headline[0]} {h.headline[1]}</span><span class="promise-outcome">{h.headline[2]}</span></h1>
          <p class="hero-intro">{h.intro}</p>
          <a class="button button-primary" href="/quiz">{h.cta} <Arrow /></a>
          <p class="button-note">{e.heroNote}</p>
        </div>
        <a class="hero-practice-peek" href="/vsl#first-practice" aria-label={e.peekLabel}>
          <span class="peek-heading">{e.peekTitle} <Arrow /></span>
          <strong>{content.practice.fields[2].label}</strong>
          <span>{e.peekBody}</span>
        </a>
        <span class="hero-image-caption">{e.illustrationLabel}</span>
      </section>
      <div class="opening-path wrap">
        <p class="opening-path-intro">{e.pathTitle}</p>
        <ol class="grid gap-6 md:grid-cols-3" aria-label={e.pathLabel}>
          {e.path.map((step,i)=><li><span class="path-number">0{i+1}</span><span><strong>{step.title}</strong><span>{step.body}</span></span></li>)}
        </ol>
      </div>
    </div>
    <section class="recognition-section wrap" data-motion="text" aria-labelledby="recognition-title">
      <div><p class="section-kicker">{e.recognitionKicker}</p><h2 id="recognition-title">{h.recognitionTitle[0]}<br /><span>{h.recognitionTitle[1]}</span></h2></div>
      <div>{h.recognitionBody.map((p,i)=><p class={i===0?'lead':undefined}>{p}</p>)}<p class="program-definition">{h.body}</p></div>
    </section>
    <section class="product-inside" id="inside" aria-labelledby="inside-title">
      <div class="wrap">
        <div class="section-heading" data-motion="text"><p class="section-kicker">{e.insideKicker}</p><h2 id="inside-title">{h.insideTitle[0]}<br />{h.insideTitle[1]}</h2><div>{h.insideBody.map(p=><p>{p}</p>)}</div></div>
        <div class="product-phases grid md:grid-cols-3">
          {h.phases.map((p,i)=><article class="product-phase" data-motion="text">
            <div class="phase-name"><span class="phase-order" aria-label={copy(h.phaseLabel,{number:i+1})}>0{i+1}</span><h3>{p.name}</h3></div>
            <div><h4>{p.title}</h4><p>{p.body}</p></div>
            <p class="phase-output"><span aria-hidden="true">↳</span>{p.output}</p>
          </article>)}
        </div>
        <p class="availability-note">{h.availability}</p>
      </div>
    </section>
    <section class="example-section" aria-labelledby="example-title">
      <div class="wrap example-layout">
        <div data-motion="text"><p class="section-kicker">{e.exampleKicker}</p><h2 id="example-title">{h.exampleTitle[0]}<br />{h.exampleTitle[1]}</h2><p>{h.exampleBody}</p><p class="example-disclosure">{h.exampleDisclosure}</p><a href="/vsl#first-practice" class="button button-dark">{h.exampleCta} <Arrow /></a></div>
        <div id="example-story" class="example-workbook" data-motion>
          <div class="workbook-masthead"><img src="/brand/logo-ink.svg" width="478" height="80" alt={content.tokens.BRAND} /><span>{e.workbookLabel}</span></div>
          <div class="example-controls" role="group" aria-label={h.exampleLabel}>{h.exampleSteps.map((s,i)=><button type="button" data-example-step={i} aria-pressed={i===0}><span class="example-step-number" aria-hidden="true">0{i+1}</span>{s.label}</button>)}</div>
          {h.exampleSteps.map((s,i)=><div data-example-panel={i} hidden={i!==0}><h3>{s.title}</h3><p>{s.body}</p><p class="example-question">{s.prompt}</p></div>)}
        </div>
      </div>
    </section>
    <section class="fit-section wrap" aria-labelledby="fit-title">
      <figure class="context-photo" data-motion><img src="/brand/quiet-practice-v5.webp" width="1536" height="1024" loading="lazy" alt={e.routinePhotoAlt} /><figcaption>{h.photoCaption} <span>{e.illustrationLabel}</span></figcaption></figure>
      <div data-motion="text"><p class="section-kicker">{e.fitKicker}</p><h2 id="fit-title">{h.fitTitle[0]}<br />{h.fitTitle[1]}</h2><p class="lead">{h.fitIntro}</p><ul class="plain-list">{h.fitItems.map(p=><li><span aria-hidden="true">↗</span>{p}</li>)}</ul></div>
    </section>
    <section class="faq-section wrap" aria-labelledby="faq-title"><div><p class="section-kicker">{e.faqKicker}</p><h2 id="faq-title">{h.faqTitle[0]}<br />{h.faqTitle[1]}</h2></div><div class="faqs">{h.faqs.map(f=><details><summary>{f.q}</summary><p>{f.a}</p></details>)}</div></section>
    <section class="product-close" data-motion="text"><div class="wrap"><p class="section-kicker">{e.closeKicker}</p><h2>{h.closeTitle[0]}<br />{h.closeTitle[1]}</h2><p>{h.closeBody}</p><a class="button button-primary" href="/quiz">{h.cta} <Arrow /></a><p class="button-note">{h.status}</p></div></section>
  </main>
  <BrandFooter />
  <script>import '../lib/page-motion';</script>
</Funnel>
